# new built in function additions :

# len() function

print(len("Sample String")) # 13
a = "My Name"
b = "is Manoj"
print(len(a+b)) # 15

# type() function

print(type("Sample String")) # Returns 'STRING'
print(type(10)) # Returns 'NUMBER'
print(type(True)) # Returns 'BOOLEAN'
print(type(None)) # Returns 'NONE'